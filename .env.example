# Supabase Configuration (Frontend & Backend)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-side only (never expose to browser / client components)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Midtrans Payment Gateway Configuration
# Get keys from Midtrans Merchant Dashboard (Settings > Access Keys)
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxxx

# Google Gemini AI Integration (Server-side AI Advisor & Chat)
GEMINI_API_KEY=your-gemini-api-key

# Production Site URL (Base Domain)
NEXT_PUBLIC_SITE_URL=https://business-health-checkup-fluxa.vercel.app