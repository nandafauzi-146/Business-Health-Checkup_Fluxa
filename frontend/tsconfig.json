{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@intelligence/*": [
        "../intelligence/*"
      ],
      "@backend/*": [
        "../backend/*"
      ],
      "@database/*": [
        "../database/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    "../intelligence/**/*.ts",
    "../database/**/*.ts",
    "../.next/types/**/*.ts",
    "../.next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "../node_modules"
  ]
}
